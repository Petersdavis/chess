rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allows anyone to read from the games collection
    // Servers using the Firebase Admin SDK automatically bypass these rules
    // so they will still be able to write and update documents.
    match /games/{gameId} {
      allow read: if true;
      allow write: if false; 
    }
    
    // Players collection is read-only for clients
    match /players/{playerId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Analysis collection has no client access (neither read nor write)
    match /analysis/{analysisId} {
      allow read, write: if false;
    }
    
    // Users collection restricts read/write to the authenticated and verified owner of the document
    match /users/{userId} {
      allow read, write: if request.auth != null 
                         && request.auth.token.email_verified == true 
                         && request.auth.uid == userId;
    }

    // Billing collection allows verified users to read their own records but not write
    match /billing/{userId}/{document=**} {
      allow read: if request.auth != null 
                  && request.auth.token.email_verified == true 
                  && request.auth.uid == userId;
      allow write: if false;
    }

    // Deny access to everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
